# Copie para development.env / homologation.env / production.env (um por ambiente).
# O ambiente é escolhido por NODE_ENV. Cada um deve apontar para a SUA branch Neon.
# Para preencher as variáveis Neon:
#   neon env pull --branch <development|homologation|production> --file <ambiente>.env

# App
PORT=3000
JWT_SECRET='troque-por-uma-string-longa-e-aleatoria'

# Neon Postgres (DATABASE_URL = pooler, usada pelo app; UNPOOLED = migrations)
DATABASE_URL='postgresql://usuario:senha@host-pooler/neondb?sslmode=require'
DATABASE_URL_UNPOOLED='postgresql://usuario:senha@host/neondb?sslmode=require'

# Neon Object Storage (bucket privado)
STORAGE_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# IA (Google Gemini, free tier): chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite   (lista: tenta o próximo se não existir, estiver ocupado ou demorar)
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MIN_INTERVAL_MS=4500
