  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "test": "NODE_ENV=test jest --watchAll --detectOpenHandles",
    "dev": "NODE_ENV=development nodemon app.js",
    "start": "NODE_ENV=production node app.js",
    "lint": "eslint .",
    "contracts": "node scripts/gen-contracts.js",
    "contracts:check": "node scripts/gen-contracts.js --check",
    "lint:fix": "eslint . --fix",
    "test:ci": "NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate && eslint .",
    "migrate:development": "node --env-file=development.env ./node_modules/prisma/build/index.js migrate deploy",
    "migrate:homologation": "node --env-file=homologation.env ./node_modules/prisma/build/index.js migrate deploy",
    "migrate:production": "node --env-file=production.env ./node_modules/prisma/build/index.js migrate deploy",
    "start:homologation": "NODE_ENV=homologation node app.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "multer": "^2.5.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "read-excel-file": "^9.3.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}
