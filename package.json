  "description": "",
  "homepage": "https://github.com/LucasPauloOP/universe_sigma_backend#readme",
  "bugs": {
    "url": "https://github.com/LucasPauloOP/universe_sigma_backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/LucasPauloOP/universe_sigma_backend.git"
  },
  "license": "ISC",
